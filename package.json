{
  "name": "bzgamers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "npx prisma migrate deploy && next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:auth": "node test_auth.js",
    "test:integration:cache": "node test_db_cache.js"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "framer-motion": "^10.16.4",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^6.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.4.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18"
  }
}
