# API Endpoints
NEXT_PUBLIC_GAME_API_URL="https://id.twitch.tv/oauth2/token"  # Twitch OAuth endpoint
NEXT_PUBLIC_IGDB_API_URL="https://api.igdb.com/v4"  # IGDB API endpoint

# API client id
NEXT_API_CLIENT_ID="apiclientid"

# API client secret
NEXT_API_CLIENT_SECRET="change-me"

# DB
DATABASE_URL='psql://user:pass@url.tld/dbname?sslmode=require'

# Authentication (for future use)
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# site name
NEXT_PUBLIC_SITE_NAME="bz-gamers"

# Authentication (for future use)
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# canonical URL for share links and Open Graph (e.g. https://bzgamers.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# gh url
NEXT_PUBLIC_GH_URL="https://github.com/example/repo"

# optional: email to alert (max 1/hour) when Twitch/IGDB token requests fail
ADMIN_ALERT_EMAIL=""

# turnstile stuff
NEXT_TURNSTILE_SECRET_KEY="change-me"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="pubkeyhere"

# Email (Resend) — required at runtime for waitlist / password-reset / admin email
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="BZGamers <onboarding@resend.dev>"
# optional: set to "off" to disable the HaveIBeenPwned breach check at signup/reset
PWNED_PASSWORD_CHECK=""
